{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Dardito",
        "supportEmail": "dev.lucas.acces.notion@gmail.com",
        "authorizedRedirectUris": [
          "https://dardito-742d2.firebaseapp.com/__/auth/handler"
        ]
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "terminos_y_politicas/**",
      "condiciones_del_servicio/**",
      "eliminacion_de_datos/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/historias/**",
        "function": {
          "functionId": "publicStoryPage",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/story-images/**",
        "function": {
          "functionId": "publicStoryImage",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "publicSitemap",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/stories",
        "function": {
          "functionId": "publicStories",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/catalogs",
        "function": {
          "functionId": "publicCatalogs",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/chat",
        "function": {
          "functionId": "darditoChatPreproduction",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/story-submissions",
        "function": {
          "functionId": "submitStory",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/story-likes",
        "function": {
          "functionId": "storyLikes",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/access",
        "function": {
          "functionId": "userAccessStatus",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/profile",
        "function": {
          "functionId": "upsertUserProfile",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/usage",
        "function": {
          "functionId": "usageAnalytics",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 4174
    },
    "ui": {
      "enabled": true
    }
  }
}
